# E2E test config (local-dev: separate e2e/.env.test). Copy to
# e2e/.env.test only when overriding the canonical trusted HTTPS hosts.
#
# FRONTEND_BASE_URL  the SPA origin Playwright drives in the browser.
# API_BASE_URL       the external app origin the APIRequestContext seeds against.
# MCP_BASE_URL       the MCP resource origin used by the official client.
FRONTEND_BASE_URL=https://app.wren.test
API_BASE_URL=https://api.wren.test
MCP_BASE_URL=https://mcp.wren.test
