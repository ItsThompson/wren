{
  "name": "wren-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Wren end-to-end Playwright suite: the study spine against the live Docker Compose stack, workers:1 / fullyParallel:false, per-test unique users, API seeding + UI smoke.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
