{
  "name": "wren-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Wren end-to-end Playwright suite against the live production-mode HTTPS Docker Compose stack, workers:1 local / workers:2 CI, fullyParallel:false, and per-test unique users.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:fixtures:parallel": "vitest run fixtures/callback-recorder.test.ts --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
